--- /dev/null
+++ b/src/tablet_posture.cpp
@@ -0,0 +1,259 @@
+/**
+ * @file src/tablet_posture.cpp
+ * @brief Client-driven laptop/slate state (see src/tablet_posture.h); platform backends do the actual switching.
+ */
+// standard includes
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+
+// local includes
+#include "src/config.h"
+#include "src/logging.h"
+#include "src/tablet_posture.h"
+
+using namespace std::literals;
+
+namespace tablet_posture {
+  namespace backend {
+    /// Switch the host to `state`. Returns false when the platform could not do it. Implemented per platform.
+    bool apply(state_e state);
+
+    /// Enter (`true`) or leave (`false`) the gaming posture, the Xbox full screen experience. Only called while the host is a slate. Implemented per platform.
+    gaming_result_e apply_gaming(bool enter);
+
+    /// Undo a previous host process' leftovers; with `resync` also put a freshly booted indicator back to laptop. Implemented per platform.
+    void recover(bool resync);
+
+    /// Undo what a previous host process left behind for the gaming posture. Returns true when that process
+    /// entered the gaming posture and never left it. Implemented per platform.
+    bool recover_gaming();
+  }  // namespace backend
+
+#ifndef _WIN32
+  namespace backend {
+    bool apply(state_e) {
+      return true;
+    }
+
+    gaming_result_e apply_gaming(bool) {
+      return gaming_result_e::switched;
+    }
+
+    void recover(bool) {}
+
+    bool recover_gaming() {
+      return false;
+    }
+  }  // namespace backend
+#endif
+
+  namespace {
+    constexpr auto retry_delay = 5s;
+
+    std::mutex mutex;
+    std::condition_variable wake;
+    registry_t registry;
+    state_e applied = state_e::laptop;
+    bool gaming_applied = false;
+    std::thread worker;
+    bool stopping = false;
+
+    const char *name(state_e state) {
+      return state == state_e::slate ? "slate (tablet)" : "laptop (desktop)";
+    }
+
+    const char *mode_name(client_mode_e mode) {
+      switch (mode) {
+        case client_mode_e::tablet:
+          return "tablet";
+        case client_mode_e::handheld:
+          return "handheld";
+        case client_mode_e::desktop:
+          break;
+      }
+      return "desktop";
+    }
+
+    void worker_main() {
+      std::unique_lock lock {mutex};
+      std::optional<std::chrono::steady_clock::time_point> laptop_due;
+      std::optional<std::chrono::steady_clock::time_point> retry_due;
+      std::optional<std::chrono::steady_clock::time_point> gaming_leave_due;
+      // The wanted gaming state that needs no further attempt until it changes again: the enter failed, or
+      // the user was in the gaming posture already.
+      std::optional<bool> gaming_settled_for;
+      while (!stopping) {
+        const auto wanted = registry.state();
+        const bool wanted_gaming = registry.gaming();
+        const auto now = std::chrono::steady_clock::now();
+
+        if (gaming_settled_for && *gaming_settled_for != wanted_gaming) {
+          gaming_settled_for.reset();
+        }
+
+        // Leave the gaming posture first, after the same grace as laptop, and before any switch to laptop.
+        if (gaming_applied && !wanted_gaming) {
+          if (!gaming_leave_due) {
+            gaming_leave_due = now + laptop_grace;
+          }
+          if (now < *gaming_leave_due) {
+            wake.wait_until(lock, *gaming_leave_due);
+            continue;
+          }
+          gaming_leave_due.reset();
+          lock.unlock();
+          const auto left = backend::apply_gaming(false);
+          lock.lock();
+          if (left == backend::gaming_result_e::failed) {
+            BOOST_LOG(warning) << "Tablet posture: could not leave the Xbox full screen experience"sv;
+          }
+          gaming_applied = false;
+          if (registry.state() == state_e::laptop) {
+            laptop_due = std::chrono::steady_clock::now();  // the grace already passed
+          }
+          continue;
+        }
+        gaming_leave_due.reset();
+
+        if (wanted != applied) {
+          if (retry_due && now < *retry_due) {
+            wake.wait_until(lock, *retry_due);
+            continue;
+          }
+          if (wanted == state_e::laptop) {
+            if (!laptop_due) {
+              laptop_due = now + laptop_grace;
+            }
+            if (now < *laptop_due) {
+              wake.wait_until(lock, *laptop_due);
+              continue;
+            }
+          }
+          laptop_due.reset();
+          lock.unlock();
+          const bool ok = backend::apply(wanted);
+          lock.lock();
+          if (ok) {
+            BOOST_LOG(info) << "Tablet posture: host is now "sv << name(wanted);
+            applied = wanted;
+            retry_due.reset();
+          } else {
+            BOOST_LOG(warning) << "Tablet posture: could not switch the host to "sv << name(wanted) << "; retrying"sv;
+            retry_due = std::chrono::steady_clock::now() + retry_delay;
+          }
+          continue;
+        }
+        laptop_due.reset();
+        retry_due.reset();
+
+        if (wanted_gaming && applied == state_e::slate && !gaming_applied && !gaming_settled_for) {
+          lock.unlock();
+          const auto entered = backend::apply_gaming(true);
+          lock.lock();
+          if (entered == backend::gaming_result_e::switched) {
+            BOOST_LOG(info) << "Tablet posture: host is now in the Xbox full screen experience"sv;
+            gaming_applied = true;
+          } else if (entered == backend::gaming_result_e::already) {
+            // The user chose it before the session, so it is not the host's to leave afterwards.
+            BOOST_LOG(info) << "Tablet posture: host was already in the Xbox full screen experience; it stays on after the session"sv;
+            gaming_settled_for = true;
+          } else {
+            BOOST_LOG(warning) << "Tablet posture: could not enter the Xbox full screen experience; staying in tablet mode"sv;
+            gaming_settled_for = true;
+          }
+          continue;
+        }
+
+        wake.wait(lock);
+      }
+    }
+
+    /// Caller holds the mutex.
+    void ensure_worker() {
+      if (!worker.joinable() && !stopping) {
+        worker = std::thread(worker_main);
+      }
+    }
+
+    void changed() {
+      ensure_worker();
+      wake.notify_all();
+    }
+  }  // namespace
+
+  posture::host_mode_e host_mode_for(const posture::hints_t &hints) {
+    const auto policy = posture::parse_handheld_policy(config::video.handheld_mode).value_or(posture::handheld_policy_e::xbox_fullscreen);
+    return posture::host_mode(hints, policy);
+  }
+
+  void client_started(const std::string &client, client_mode_e mode) {
+    if (!config::video.touch_tablet_mode) {
+      return;
+    }
+    std::lock_guard lock {mutex};
+    registry.start(client, mode);
+    changed();
+  }
+
+  void client_updated(const std::string &client, client_mode_e mode) {
+    if (!config::video.touch_tablet_mode) {
+      return;
+    }
+    std::lock_guard lock {mutex};
+    registry.update(client, mode);
+    changed();
+  }
+
+  void client_stopped(const std::string &client) {
+    std::lock_guard lock {mutex};
+    registry.stop(client);
+    changed();
+  }
+
+  void set_override(std::optional<client_mode_e> forced) {
+    std::lock_guard lock {mutex};
+    registry.set_override(forced);
+    BOOST_LOG(info) << "Tablet posture: override "sv << (forced ? mode_name(*forced) : "cleared");
+    changed();
+  }
+
+  status_t status() {
+    std::lock_guard lock {mutex};
+    std::optional<state_e> override_state;
+    if (const auto forced = registry.override_mode()) {
+      override_state = *forced == client_mode_e::desktop ? state_e::laptop : state_e::slate;
+    }
+    return {applied, registry.state(), registry.mode(), gaming_applied, override_state, registry.override_mode(), config::video.touch_tablet_mode, registry.clients()};
+  }
+
+  void recover() {
+    std::lock_guard lock {mutex};
+    backend::recover(config::video.touch_tablet_mode);
+    if (backend::recover_gaming()) {
+      // A previous host process entered the gaming posture and never left it: the worker leaves it now.
+      gaming_applied = true;
+      changed();
+    }
+  }
+
+  void shutdown() {
+    {
+      std::lock_guard lock {mutex};
+      stopping = true;
+    }
+    wake.notify_all();
+    if (worker.joinable()) {
+      worker.join();
+    }
+    std::lock_guard lock {mutex};
+    if (gaming_applied) {
+      backend::apply_gaming(false);
+      gaming_applied = false;
+    }
+    if (applied != state_e::laptop || registry.state() != state_e::laptop) {
+      backend::apply(state_e::laptop);
+      applied = state_e::laptop;
+    }
+  }
+}  // namespace tablet_posture
diff --git a/src/tablet_posture.h b/src/tablet_posture.h
new file mode 100644
index 000000000..a56df8867
--- /dev/null
+++ b/src/tablet_posture.h
@@ -0,0 +1,93 @@
+/**
+ * @file src/tablet_posture.h
+ * @brief Host laptop/slate state driven by the streaming clients' posture.
+ *
+ * Windows only switches to tablet behaviour (touch keyboard on text focus, tablet taskbar) when it
+ * believes the machine is a convertible whose keyboard is folded back or detached. A virtual
+ * display host is neither, so the host reports that state itself, through Windows' own laptop/slate
+ * indicator interface, whenever a touch-primary client streams. Clients drive it: `clientPosture`
+ * at launch and resume, and the `/posture` endpoint while streaming (keyboard attached, detached,
+ * flipped, flipped back). Controlled by the `touch_tablet_mode` option. Other platforms: no-ops.
+ *
+ * Switching to slate happens at once; switching back to laptop waits a few seconds so a resume or
+ * reconnect (which ends one session and starts the next) does not flicker the shell. All Windows work
+ * happens on a worker thread, never on a streaming or HTTP thread.
+ */
+#pragma once
+
+#include <chrono>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "posture_size.h"
+#include "tablet_posture_policy.h"
+
+namespace tablet_posture {
+  /// The mode a client's host mode asks of the posture backend.
+  inline client_mode_e to_client_mode(posture::host_mode_e mode) {
+    switch (mode) {
+      case posture::host_mode_e::tablet:
+        return client_mode_e::tablet;
+      case posture::host_mode_e::handheld:
+        return client_mode_e::handheld;
+      case posture::host_mode_e::desktop:
+        break;
+    }
+    return client_mode_e::desktop;
+  }
+
+  /// Host mode for these hints, with the configured `handheld_mode` policy applied. Hints must already include any per-client override.
+  posture::host_mode_e host_mode_for(const posture::hints_t &hints);
+
+  /// Delay before the host returns to laptop after the last touch-primary client left.
+  inline constexpr std::chrono::milliseconds laptop_grace {3000};
+
+  /// A session of `client` started. `mode` is the client's current host mode.
+  void client_started(const std::string &client, client_mode_e mode);
+
+  /// The client's posture changed during a session. Ignored when the client has no active session.
+  void client_updated(const std::string &client, client_mode_e mode);
+
+  /// A session of `client` ended. The last touch-primary client leaving puts the host back to laptop.
+  void client_stopped(const std::string &client);
+
+  /// Force the state regardless of clients (a simulated keyboard detach/attach); nullopt gives control back to the clients.
+  void set_override(std::optional<client_mode_e> forced);
+
+  namespace backend {
+    /// Outcome of a request to enter or leave the gaming posture.
+    enum class gaming_result_e {
+      switched,  ///< The host made the switch.
+      already,  ///< The host was in the wanted state before; nothing was switched.
+      failed,
+    };
+  }  // namespace backend
+
+  struct status_t {
+    state_e applied;  ///< What Windows was last told.
+    state_e wanted;  ///< What the clients (or the override) ask for.
+    client_mode_e wanted_mode;  ///< The wanted state as a mode: desktop, tablet or handheld.
+    bool gaming_applied;  ///< The host entered the gaming posture (Xbox full screen experience) and will leave it.
+    std::optional<state_e> override_state;
+    std::optional<client_mode_e> override_mode;
+    bool enabled;  ///< touch_tablet_mode
+    std::vector<registry_t::client_info_t> clients;
+  };
+
+  status_t status();
+
+  /// First argument of the instance a Windows host service starts as the logged-on user to switch the
+  /// gaming posture; followed by `enter` or `leave`. Handled before any host initialization.
+  inline constexpr std::string_view gaming_switch_arg = "--gaming-posture-switch";
+
+  /// Windows: make the switch `argv[2]` asks for and return 0 when the host is in the wanted state.
+  int run_gaming_switch(int argc, char **argv);
+
+  /// At host start: undo whatever a previous host process left behind after a crash.
+  void recover();
+
+  /// At host stop: put the host back to laptop and stop the worker.
+  void shutdown();
+}  // namespace tablet_posture
diff --git a/src/tablet_posture_policy.h b/src/tablet_posture_policy.h
new file mode 100644
index 000000000..c826d1957
--- /dev/null
+++ b/src/tablet_posture_policy.h
@@ -0,0 +1,143 @@
+/**
+ * @file src/tablet_posture_policy.h
+ * @brief Pure rules for the host's laptop/slate (tablet) state.
+ *
+ * Windows decides "tablet posture" from a laptop/slate indicator, the way a convertible laptop
+ * reports its keyboard being folded back or detached. The host plays that indicator for the
+ * streaming clients: while at least one active client is touch-primary (tablet, handheld,
+ * phone, or a touch device without a declared posture) the host is a slate; with no such
+ * client, or when the client reports a laptop or desktop posture (keyboard attached), it is a
+ * laptop. This header holds the bookkeeping so it can be tested without Windows.
+ */
+#pragma once
+
+#include <cstddef>
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace tablet_posture {
+  enum class state_e {
+    laptop,  ///< Keyboard attached or folded out: Windows desktop behaviour.
+    slate,  ///< Keyboard detached or folded back: Windows tablet behaviour.
+  };
+
+  /// What a client asks of the host. Tablet and handheld both mean slate; handheld also asks for the gaming posture.
+  enum class client_mode_e {
+    desktop,
+    tablet,
+    handheld,
+  };
+
+  /// Active clients and the mode each one asks for. A client may hold several sessions.
+  class registry_t {
+  public:
+    /// A session of `client` started. Returns true when the host state changed.
+    bool start(const std::string &client, client_mode_e mode) {
+      auto &entry = clients_[client];
+      ++entry.sessions;
+      entry.mode = mode;
+      return refresh();
+    }
+
+    /// The client's posture changed while it streams. Unknown clients are ignored. Returns true when the host state changed.
+    bool update(const std::string &client, client_mode_e mode) {
+      const auto it = clients_.find(client);
+      if (it == clients_.end()) {
+        return false;
+      }
+      it->second.mode = mode;
+      return refresh();
+    }
+
+    /// A session of `client` ended. Returns true when the host state changed.
+    bool stop(const std::string &client) {
+      const auto it = clients_.find(client);
+      if (it == clients_.end()) {
+        return false;
+      }
+      if (--it->second.sessions <= 0) {
+        clients_.erase(it);
+      }
+      return refresh();
+    }
+
+    bool contains(const std::string &client) const {
+      return clients_.find(client) != clients_.end();
+    }
+
+    std::size_t size() const {
+      return clients_.size();
+    }
+
+    /// State the clients ask for, ignoring any override.
+    state_e client_state() const {
+      return client_mode_ == client_mode_e::desktop ? state_e::laptop : state_e::slate;
+    }
+
+    /// Mode the clients ask for (the strongest one: handheld, then tablet, then desktop), ignoring any override.
+    client_mode_e client_mode() const {
+      return client_mode_;
+    }
+
+    /// The mode to apply: the override when set, else what the clients ask for.
+    client_mode_e mode() const {
+      return override_.value_or(client_mode_);
+    }
+
+    /// The state to apply: slate unless the mode is desktop.
+    state_e state() const {
+      return mode() == client_mode_e::desktop ? state_e::laptop : state_e::slate;
+    }
+
+    /// True when the gaming posture (Xbox full screen experience) is wanted.
+    bool gaming() const {
+      return mode() == client_mode_e::handheld;
+    }
+
+    /// Force a mode regardless of the clients (simulates the keyboard being detached or attached). nullopt returns control to the clients.
+    void set_override(std::optional<client_mode_e> forced) {
+      override_ = forced;
+    }
+
+    std::optional<client_mode_e> override_mode() const {
+      return override_;
+    }
+
+    struct client_info_t {
+      std::string id;
+      int sessions;
+      client_mode_e mode;
+    };
+
+    std::vector<client_info_t> clients() const {
+      std::vector<client_info_t> out;
+      for (const auto &[id, entry] : clients_) {
+        out.push_back({id, entry.sessions, entry.mode});
+      }
+      return out;
+    }
+
+  private:
+    struct entry_t {
+      int sessions = 0;
+      client_mode_e mode = client_mode_e::desktop;
+    };
+
+    bool refresh() {
+      const auto before_mode = mode();
+      client_mode_ = client_mode_e::desktop;
+      for (const auto &[client, entry] : clients_) {
+        if (entry.mode > client_mode_) {
+          client_mode_ = entry.mode;
+        }
+      }
+      return mode() != before_mode;
+    }
+
+    std::map<std::string, entry_t> clients_;
+    client_mode_e client_mode_ = client_mode_e::desktop;
+    std::optional<client_mode_e> override_;
+  };
+}  // namespace tablet_posture
diff --git a/src_assets/windows/drivers/tablet-posture/cleanup.ps1 b/src_assets/windows/drivers/tablet-posture/cleanup.ps1
new file mode 100644
index 000000000..ee7cc8192
--- /dev/null
+++ b/src_assets/windows/drivers/tablet-posture/cleanup.ps1
@@ -0,0 +1,27 @@
+<#
+.SYNOPSIS
+  Removes the laptop/slate indicator device the Vibepollo host creates for tablet posture.
+
+.DESCRIPTION
+  The host creates one root-enumerated device (ROOT\HIDCLASS\*, hardware id PNP0C60) bound to Microsoft's
+  inbox "GPIO Laptop or Slate Indicator Driver". This script removes only such root-enumerated nodes.
+  A real indicator that firmware exposes (ACPI\PNP0C60) is never touched. The inbox driver package stays
+  in Windows; nothing else is installed.
+#>
+[CmdletBinding()]
+param([switch]$InstallerBestEffort)
+
+$ErrorActionPreference = 'Continue'
+try {
+    $nodes = @(Get-PnpDevice -ErrorAction SilentlyContinue | Where-Object {
+            $_.InstanceId -like 'ROOT\HIDCLASS\*' -and ($_.HardwareID -contains 'PNP0C60')
+        })
+    foreach ($node in $nodes) {
+        Write-Host "Removing laptop/slate indicator $($node.InstanceId)"
+        & "$env:SystemRoot\System32\pnputil.exe" /remove-device $node.InstanceId | Out-Null
+    }
+} catch {
+    Write-Warning "Laptop/slate indicator cleanup failed: $($_.Exception.Message)"
+    if (-not $InstallerBestEffort) { throw }
+}
+exit 0
