@@ -32,6 +32,8 @@ interface PairedDevice {
   uuid: string;
   enabled: boolean;
   allow_sleep?: boolean;
+  touch_device?: boolean;
+  posture_mode?: string;
   connected: boolean;
   perm?: number | string;
   enable_legacy_ordering?: boolean;
@@ -138,6 +140,11 @@ function stringValue(value: unknown): string {
   return '';
 }
 
+function normalizePostureMode(value: unknown): string {
+  const mode = stringValue(value).toLocaleLowerCase();
+  return ['desktop', 'tablet', 'handheld'].includes(mode) ? mode : 'auto';
+}
+
 function booleanValue(value: unknown, fallback: boolean): boolean {
   if (typeof value === 'boolean') return value;
   if (typeof value === 'number') return value !== 0;
@@ -182,6 +189,8 @@ function normalizeDevice(device: unknown, index: number): PairedDevice {
     name: stringValue(raw.name),
     enabled: booleanValue(raw.enabled, true),
     allow_sleep: raw.allow_sleep === true,
+    touch_device: raw.touch_device === true,
+    posture_mode: normalizePostureMode(raw.posture_mode),
     connected: booleanValue(raw.connected, false),
     last_seen:
       typeof raw.last_seen === 'number' || typeof raw.last_seen === 'string' ? raw.last_seen : null,
@@ -387,6 +396,8 @@ function draftFromDevice(device: PairedDevice): ClientDeviceDraft {
   return {
     name: device.name,
     allowSleep: device.allow_sleep === true,
+    touchDevice: device.touch_device === true,
+    postureMode: normalizePostureMode(device.posture_mode),
     permissions: permissionMask(device),
     enableLegacyOrdering: device.enable_legacy_ordering !== false,
     allowClientCommands: device.allow_client_commands !== false,
@@ -639,6 +650,8 @@ function updatePayload(device: PairedDevice, draft: ClientDeviceDraft): Record<s
     uuid: device.uuid,
     name: draft.name.trim(),
     allow_sleep: draft.allowSleep,
+    touch_device: draft.touchDevice,
+    posture_mode: normalizePostureMode(draft.postureMode),
     perm: draft.permissions & PERMISSION_ALL,
     enable_legacy_ordering: draft.enableLegacyOrdering,
     allow_client_commands: draft.allowClientCommands,
@@ -672,6 +685,8 @@ function updatePayload(device: PairedDevice, draft: ClientDeviceDraft): Record<s
 const draftScalarKeys = [
   'name',
   'allowSleep',
+  'touchDevice',
+  'postureMode',
   'permissions',
   'enableLegacyOrdering',
   'allowClientCommands',
