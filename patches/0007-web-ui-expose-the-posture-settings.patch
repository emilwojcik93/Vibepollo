From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: emilwojcik93 <adminit@adar.pl>
Date: Sun, 22 Nov 2026 10:07:00 +0100
Subject: [PATCH] web ui: expose the posture settings

Settings page (Windows only): touch_tablet_mode, handheld_mode (shown while
tablet mode is on) and touch_posture_diagonal_mm (100..419 mm), with locale
strings. Devices page: per-client "Treat this device as a touch device" switch
and per-client posture mode select (auto, desktop, tablet, handheld) in the
client editor, sent through /api/clients/update. The v2 parity test knows the
new keys.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../devices/ClientSettingsEditor.vue          | 42 +++++++++++++++++++
 src_assets/common/assets/web/config.html      |  3 ++
 .../assets/web/configs/configFieldSchema.ts   |  1 +
 .../assets/web/configs/settingsSchema.ts      | 20 +++++++++
 .../assets/web/public/assets/locale/en.json   |  9 ++++
 .../web/public/assets/locale/ui/en.json       | 10 ++++-
 .../assets/web/scripts/v2-parity.test.ts      |  3 ++
 .../common/assets/web/views/DevicesView.vue   | 15 +++++++
 8 files changed, 102 insertions(+), 1 deletion(-)

diff --git a/src_assets/common/assets/web/components/devices/ClientSettingsEditor.vue b/src_assets/common/assets/web/components/devices/ClientSettingsEditor.vue
index aa1163b97..351e5415c 100644
--- a/src_assets/common/assets/web/components/devices/ClientSettingsEditor.vue
+++ b/src_assets/common/assets/web/components/devices/ClientSettingsEditor.vue
@@ -25,6 +25,8 @@ export interface ClientCommandDraft {
 export interface ClientDeviceDraft {
   name: string;
   allowSleep: boolean;
+  touchDevice: boolean;
+  postureMode: string;
   permissions: number;
   enableLegacyOrdering: boolean;
   allowClientCommands: boolean;
@@ -240,6 +242,13 @@ const displayOverrideSummary = computed(() => {
   return mode;
 });
 
+const postureModeOptions = computed(() => [
+  { label: t('ui.devices.editor.posture_mode_auto'), value: 'auto' },
+  { label: t('ui.devices.editor.posture_mode_desktop'), value: 'desktop' },
+  { label: t('ui.devices.editor.posture_mode_tablet'), value: 'tablet' },
+  { label: t('ui.devices.editor.posture_mode_handheld'), value: 'handheld' },
+]);
+
 const hdrProfileOptions = computed(() => {
   const profiles = [...props.hdrProfiles].sort(
     (left, right) => Number(right.added_ms ?? 0) - Number(left.added_ms ?? 0),
@@ -447,6 +456,39 @@ function applyDisplaySelection(selection: ClientDisplaySelection): void {
             <span class="vs-sr-only">{{ t('ui.devices.editor.allow_sleep') }}</span>
           </label>
         </SettingRow>
+        <SettingRow
+          class="client-setting-row--switch"
+          :label="t('ui.devices.editor.touch_device')"
+          :description="t('ui.devices.editor.touch_device_description')"
+          :control-id="`${controlIdPrefix}-touch-device`"
+        >
+          <label class="vs-switch">
+            <input
+              :id="`${controlIdPrefix}-touch-device`"
+              v-model="draft.touchDevice"
+              type="checkbox"
+              :disabled="busy"
+            />
+            <span class="vs-switch__track" aria-hidden="true" />
+            <span class="vs-sr-only">{{ t('ui.devices.editor.touch_device') }}</span>
+          </label>
+        </SettingRow>
+        <SettingRow
+          :label="t('ui.devices.editor.posture_mode')"
+          :description="t('ui.devices.editor.posture_mode_description')"
+          :control-id="`${controlIdPrefix}-posture-mode`"
+        >
+          <select
+            :id="`${controlIdPrefix}-posture-mode`"
+            v-model="draft.postureMode"
+            class="vs-select"
+            :disabled="busy"
+          >
+            <option v-for="option in postureModeOptions" :key="option.value" :value="option.value">
+              {{ option.label }}
+            </option>
+          </select>
+        </SettingRow>
         <SettingRow :label="t('pin.device_name')" :control-id="`${controlIdPrefix}-name`">
           <input
             :id="`${controlIdPrefix}-name`"
